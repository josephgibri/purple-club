generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Merchant identity (external businesses — email/password).
//
// This was the original `User` model. It was renamed to `Merchant` during
// the PurpleStay consolidation so the wallet-keyed member can take the
// canonical `User` name. The DB table is renamed in lockstep via a manual
// `ALTER TABLE "User" RENAME TO "Merchant"` so existing rows are preserved.
//
// The `ADMIN` role value is retired in favor of wallet-based Perks admins
// (PERKS_ADMIN_WALLETS); the enum is kept to avoid a destructive column
// migration.
// ---------------------------------------------------------------------------

enum UserRole {
  MERCHANT
  ADMIN
}

enum ListingStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ReviewAction {
  APPROVED
  REJECTED
  SENT_BACK
  EDITED
}

/**
 * Funnel events emitted for an approved merchant listing. The
 * directory + drawer fire the web-side ones from the browser via
 * /api/track; PASS_SCAN is server-issued by /api/public/verify-pass
 * and never accepted from a client (otherwise a curl could pad a
 * merchant's metrics).
 */
enum ListingEventType {
  IMPRESSION
  DRAWER_OPEN
  CODE_COPY
  WEBSITE_CLICK
  MAPS_CLICK
  PASS_SCAN
}

model Merchant {
  id           String               @id @default(cuid())
  email        String               @unique
  username     String               @unique
  passwordHash String
  role         UserRole             @default(MERCHANT)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  profile      MerchantProfile?
  reviews      ListingReview[]      @relation("AdminReviews")
  resetTokens  PasswordResetToken[]
}

/**
 * Single-use password reset tokens. We persist the SHA-256 hash of the
 * raw token (never the raw token itself), so even a leaked DB dump
 * can't be replayed against the /reset endpoint. The raw token is only
 * ever surfaced once — via the reset email link.
 */
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      Merchant @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model MerchantProfile {
  id          String            @id @default(cuid())
  userId      String            @unique
  displayName String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        Merchant          @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings    MerchantListing[]
}

model ListingEvent {
  id          String           @id @default(cuid())
  listingId   String
  eventType   ListingEventType
  /**
   * Opaque viewer fingerprint: sha256(ip + ua + dayBucket + ANALYTICS_HASH_SALT).
   * Stable for ~24h so we can compute uniques without storing any PII.
   * Rotates daily so the same IP+UA becomes a brand-new fingerprint
   * the next day — bounds the per-viewer linkability.
   */
  viewerHash  String
  country     String?
  city        String?
  uaKind      String?
  referrer    String?
  createdAt   DateTime         @default(now())
  listing     MerchantListing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, createdAt])
  @@index([listingId, eventType, createdAt])
}

model MerchantListing {
  id               String         @id @default(cuid())
  merchantProfileId String
  merchantId       String         @unique
  businessName     String
  businessBrief    String
  category         String
  isOnline         Boolean
  /**
   * Channel mix. Values: "ONLINE" | "LOCAL" | "HYBRID".
   * - ONLINE: website only, no physical address shown.
   * - LOCAL:  physical storefront only, redeems via the Purple Club pass at the counter.
   * - HYBRID: both — has a website AND a physical storefront, so a promo code AND an
   *           in-person pass scan are both valid redemption paths.
   * Existing rows are backfilled from `isOnline` at migration time
   * (true → "ONLINE", false → "LOCAL") so legacy listings keep
   * working without any data loss.
   */
  merchantType     String         @default("LOCAL")
  country          String
  city             String
  fullAddress      String
  lat              Float?
  lng              Float?
  website          String
  logoUrl          String
  heroImageUrl     String
  promoCode        String?
  discountDetails  String
  socialPlatform   String?
  socialHandle     String?
  fsqId            String?
  fsqName          String?
  fsqAddress       String?
  fsqVerifiedAt    DateTime?
  adminNotes       String?
  status           ListingStatus  @default(DRAFT)
  rejectionReason  String?
  approvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  profile          MerchantProfile @relation(fields: [merchantProfileId], references: [id], onDelete: Cascade)
  reviews          ListingReview[]
  events           ListingEvent[]
}

model ListingReview {
  id           String          @id @default(cuid())
  listingId    String
  // Legacy reviewer FK (email-based ADMIN merchant). Kept nullable for old
  // rows; new reviews are wallet-based and recorded via `adminWallet`.
  adminUserId  String?
  // Wallet pubkey of the reviewer (founder / perks admin) — the canonical
  // reviewer identity now that the Perks desk is wallet-gated.
  adminWallet  String?
  action       ReviewAction
  notes        String?
  createdAt    DateTime        @default(now())
  listing      MerchantListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  admin        Merchant?       @relation("AdminReviews", fields: [adminUserId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Member identity + Travel / Gifts / Campaigns / Burn (ported from PurpleStay).
//
// The canonical `User` is keyed by Solana wallet pubkey. Members, agents,
// founders, and promoters all authenticate as this single wallet identity;
// elevated roles are resolved from env allowlists (not stored here).
// ---------------------------------------------------------------------------

enum TravelRequestStatus {
  PENDING
  OFFER_READY
  OFFER_EXPIRED
  PAYMENT_SUBMITTED
  PAYMENT_VERIFIED
  CONFIRMED
  CANCELLED
}

enum CancellationKind {
  PRE_PAYMENT
  REFUND_REQUESTED
}

enum CancellationStatus {
  OPEN
  PROCESSED
  REJECTED
}

enum CancellationActor {
  MEMBER
  AGENT
}

enum GiftStatus {
  CREATED
  CLAIMED
  FULFILLING
  FULFILLED
  FULFILLMENT_FAILED
  REJECTED
}

enum CampaignClaimStatus {
  CLAIMED
  FULFILLING
  FULFILLED
  FULFILLMENT_FAILED
}

enum OfferMode {
  REQUESTED_HOTEL
  ALTERNATIVES
  BOTH
}

enum RefundabilityPreference {
  REFUNDABLE
  NON_REFUNDABLE
  FLEXIBLE
}

enum PaymentMethod {
  STRIPE
  USDC
  CASH
}

enum MealPreference {
  ROOM_ONLY
  BREAKFAST
  HALF_BOARD
  FULL_BOARD
  ALL_INCLUSIVE
}

enum ChangeRequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum BurnEventKind {
  GENESIS
  MONTHLY
}

/// How a campaign distributes its PBTC reward.
///
/// PUBLIC_SLUG (legacy default) is the shared /invite/{slug} link — anyone
/// with the link can claim once per wallet up to `maxClaims`.
///
/// UNIQUE_CODES is the curated mode: the promoter signs in at /promoter
/// (gated by `promoterWallet`) and mints one-shot GiftClaim codes per
/// invitee. Each invitee redeems via /claim/{code} like any other gift.
enum CampaignMode {
  PUBLIC_SLUG
  UNIQUE_CODES
}

model User {
  id                       String                    @id @default(cuid())
  wallet                   String                    @unique
  email                    String?
  hasUnlockedGifting       Boolean                   @default(false)
  travelRequests           TravelRequest[]
  giftClaimsCreated        GiftClaim[]               @relation("GiftClaimCreator")
  giftClaimsRedeemed       GiftClaim[]               @relation("GiftClaimRecipient")
  campaignClaimsRedeemed   InfluencerCampaignClaim[] @relation("CampaignClaimRecipient")
  telegramMember           TelegramMember?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
}

// ---------------------------------------------------------------------------
// Telegram social layer — Purple Connect (@Purple_connect_bot).
//
// TelegramMember links a Telegram user to a verified Purple Club wallet (via
// SIWS on /link/telegram). The cron at /api/cron/telegram-sync polls each
// linked wallet's PBTC balance, applies the 7-day promotion hold, and
// enforces group eligibility (≥ 1 PBTC).
//
// Tier promotion: qualifyingTier is the tier the live balance earns.
//   - promotion:  pendingTier + pendingSince track the hold clock;
//                 effectiveTier is set once pendingSince is ≥ 7 days ago.
//   - demotion:   immediate — effectiveTier snaps down when balance drops.
//   - kick:       inGroup flips false and Telegram kick is issued once
//                 the balance has been below 1 PBTC for > GRACE_HOURS.
// ---------------------------------------------------------------------------

/// A Telegram user who has linked their wallet via SIWS.
model TelegramMember {
  id            String    @id @default(cuid())
  /// Telegram numeric user ID (64-bit safe).
  telegramId    BigInt    @unique
  username      String?
  /// Verified Purple Club wallet — set once SIWS is complete.
  userId        String?   @unique
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Tier currently displayed / enforced (e.g. "Commander").
  /// Null until first balance check after linking.
  effectiveTier String?
  /// When the current effectiveTier was first earned (for display).
  tierSince     DateTime?
  /// Tier waiting on the 7-day promotion hold.
  pendingTier   String?
  pendingSince  DateTime?
  /// Whether the bot believes this user is currently in the main group.
  inGroup       Boolean   @default(false)
  /// Timestamp when the balance first dropped below 1 PBTC (grace window).
  belowThresholdSince DateTime?
  lastBalance   Decimal?  @db.Decimal(20, 9)
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([inGroup])
  @@index([lastCheckedAt])
}

/// One-time token that binds a Telegram user to a Purple Club SIWS sign-in.
/// Generated by the bot; consumed by /link/telegram after signature.
model TelegramLinkSession {
  id         String    @id @default(cuid())
  token      String    @unique @default(cuid())
  telegramId BigInt
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([telegramId])
  @@index([expiresAt])
}

/// Founding members — the first N wallets observed holding >= 1 PBTC after
/// this shipped. `seq` is assigned in arrival order and locked for life, so
/// founding membership never reshuffles. The "Founding Member" seal is shown
/// only while the wallet still holds >= 1 PBTC (enforced at display time), but
/// the slot itself is permanent — drop below and re-acquire, the seal returns.
model FoundingMember {
  id        String   @id @default(cuid())
  wallet    String   @unique
  seq       Int      @unique
  createdAt DateTime @default(now())

  @@index([seq])
}

model TravelRequest {
  id                       String                  @id @default(cuid())
  requestCode              String                  @unique
  userId                   String
  user                     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet                   String
  hotelUrl                 String
  checkInDate              DateTime
  checkOutDate             DateTime
  roomType                 String
  occupancy                Int
  childrenCount            Int                     @default(0)
  infantsCount             Int                     @default(0)
  refundabilityPreference  RefundabilityPreference
  nationality              String?
  mealPreference           MealPreference          @default(BREAKFAST)
  status                   TravelRequestStatus     @default(PENDING)
  offerMode                OfferMode               @default(REQUESTED_HOTEL)
  requestedHotelName       String?
  publicPriceUsd           Decimal?                @db.Decimal(10, 2)
  purplePriceUsd           Decimal?                @db.Decimal(10, 2)
  requestedHotelOffers     Json?
  alternativeOffers        Json?
  selectedOfferKey         String?
  bookingGuests            Json?
  stripePaymentLink        String?
  voucherUrl               String?
  voucherFileName          String?
  voucherUploadedAt        DateTime?
  usdcPaymentAddress       String?
  paymentMethod            PaymentMethod?
  paymentReference         String?
  paymentNote              String?
  paymentSubmittedAt       DateTime?
  paymentRejectReason      String?
  expectedUsdcLamports     BigInt?
  paymentReferencePubkey   String?
  paymentTxSignature       String?                 @unique
  paymentVerifiedAt        DateTime?
  paymentVerifiedAmountLamports BigInt?
  changeRequestStatus      ChangeRequestStatus?
  changeRequestType        String?
  changeRequestNote        String?
  changeRequestOpenedAt    DateTime?
  changeRequestResolvedAt  DateTime?
  agentChangeReply         String?
  offerSentAt              DateTime?
  offerExpiresAt           DateTime?
  offerHistory             Json?
  cancelledAt              DateTime?
  cancelReason             String?
  cancelActor              CancellationActor?
  archivedAt               DateTime?
  githubIssueNumber        Int?
  githubIssueUrl           String?
  submittedAt              DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  cancellation             Cancellation?
}

model Cancellation {
  id                String              @id @default(cuid())
  travelRequestId   String              @unique
  travelRequest     TravelRequest       @relation(fields: [travelRequestId], references: [id], onDelete: Cascade)
  kind              CancellationKind
  status            CancellationStatus  @default(OPEN)
  actor             CancellationActor
  reason            String?
  refundAmountUsd     Decimal?            @db.Decimal(10, 2)
  refundFeePercent    Int?
  policySnapshot      Json?
  agentNote           String?
  /// Solana tx signature for USDC refunds, or Stripe refund ID for card
  /// refunds. Unique so the agent cannot accidentally double-process the
  /// same tx onto two cancellations.
  refundTxSignature   String?             @unique
  refundProcessedBy   String?
  requestedAt         DateTime            @default(now())
  processedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model GiftClaim {
  id                    String              @id @default(cuid())
  code                  String              @unique
  creatorUserId         String
  creator               User                @relation("GiftClaimCreator", fields: [creatorUserId], references: [id], onDelete: Cascade)
  recipientUserId       String?
  recipient             User?               @relation("GiftClaimRecipient", fields: [recipientUserId], references: [id])
  recipientWallet       String?
  recipientEmail        String?
  status                GiftStatus          @default(CREATED)
  txSignature           String?
  agentNote             String?
  fulfillmentError      String?
  fulfillmentAttempts   Int                 @default(0)
  fulfillmentStartedAt  DateTime?
  /// When this claim was minted by a promoter under a UNIQUE_CODES
  /// campaign, the source campaign. Nullable for organic member-to-member
  /// gifts (created via POST /api/gifts).
  campaignId            String?
  campaign              InfluencerCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt             DateTime            @default(now())
  claimedAt             DateTime?
  fulfilledAt           DateTime?
  updatedAt             DateTime            @updatedAt

  @@index([creatorUserId])
  @@index([recipientUserId])
  @@index([campaignId])
}

model InfluencerCampaign {
  id              String                    @id @default(cuid())
  slug            String                    @unique
  label           String
  notes           String?
  maxClaims       Int
  claimsUsed      Int                       @default(0)
  rewardLamports  String                    @default("1000000000")
  endsAt          DateTime
  paused          Boolean                   @default(false)
  createdByWallet String?
  /// Distribution model — see `CampaignMode`.
  mode            CampaignMode              @default(PUBLIC_SLUG)
  /// For UNIQUE_CODES campaigns, the promoter wallet allowed to mint codes.
  promoterWallet  String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  claims          InfluencerCampaignClaim[]
  /// Codes minted under this campaign in UNIQUE_CODES mode.
  giftClaims      GiftClaim[]

  @@index([endsAt])
  @@index([paused])
  @@index([promoterWallet])
}

model InfluencerCampaignClaim {
  id                    String              @id @default(cuid())
  campaignId            String
  campaign              InfluencerCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  recipientUserId       String?
  recipient             User?               @relation("CampaignClaimRecipient", fields: [recipientUserId], references: [id])
  recipientWallet       String
  recipientEmail        String?
  status                CampaignClaimStatus @default(CLAIMED)
  txSignature           String?
  fulfillmentError      String?
  fulfillmentAttempts   Int                 @default(0)
  fulfillmentStartedAt  DateTime?
  claimedAt             DateTime            @default(now())
  fulfilledAt           DateTime?
  updatedAt             DateTime            @updatedAt
  ipHash                String?

  @@unique([campaignId, recipientWallet])
  @@index([campaignId])
  @@index([recipientUserId])
  @@index([campaignId, ipHash])
}

model BurnEvent {
  id                  String         @id @default(cuid())
  kind                BurnEventKind  @default(MONTHLY)
  periodLabel         String         @unique
  fulfilledStaysCount Int?
  usdSpent            Decimal?       @db.Decimal(12, 2)
  pbtcLamportsBurned  BigInt
  txSignature         String?        @unique
  txSignatures        Json?
  note                String?
  committedAt         DateTime       @default(now())
  committedBy         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([kind])
  @@index([committedAt])
}
