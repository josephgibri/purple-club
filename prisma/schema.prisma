generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MERCHANT
  ADMIN
}

enum ListingStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ReviewAction {
  APPROVED
  REJECTED
  SENT_BACK
  EDITED
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  username     String            @unique
  passwordHash String
  role         UserRole          @default(MERCHANT)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  profile      MerchantProfile?
  reviews      ListingReview[]   @relation("AdminReviews")
}

model MerchantProfile {
  id          String            @id @default(cuid())
  userId      String            @unique
  displayName String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings    MerchantListing[]
}

model MerchantListing {
  id               String         @id @default(cuid())
  merchantProfileId String
  merchantId       String         @unique
  businessName     String
  businessBrief    String
  category         String
  isOnline         Boolean
  country          String
  city             String
  fullAddress      String
  lat              Float?
  lng              Float?
  website          String
  logoUrl          String
  heroImageUrl     String
  promoCode        String?
  discountDetails  String
  socialPlatform   String?
  socialHandle     String?
  fsqId            String?
  fsqName          String?
  fsqAddress       String?
  fsqVerifiedAt    DateTime?
  adminNotes       String?
  status           ListingStatus  @default(DRAFT)
  rejectionReason  String?
  approvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  profile          MerchantProfile @relation(fields: [merchantProfileId], references: [id], onDelete: Cascade)
  reviews          ListingReview[]
}

model ListingReview {
  id           String          @id @default(cuid())
  listingId    String
  adminUserId  String
  action       ReviewAction
  notes        String?
  createdAt    DateTime        @default(now())
  listing      MerchantListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  admin        User            @relation("AdminReviews", fields: [adminUserId], references: [id], onDelete: Cascade)
}
