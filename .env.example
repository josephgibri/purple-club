# Solana RPC — optional. Falls back to public mainnet-beta cluster.
NEXT_PUBLIC_HELIUS_RPC_URL=
NEXT_PUBLIC_ALCHEMY_RPC_URL=
NEXT_PUBLIC_SOLANA_RPC_URL=

# --- Database + auth (v2) ---
DATABASE_URL=
# Dedicated auth secret. If missing, JWT_SIGNING_SECRET is used as fallback.
AUTH_JWT_SECRET=
# Comma-separated emails that should get ADMIN role on registration.
ADMIN_EMAILS=

# Address autocomplete and reverse-geocoding are powered by
# OpenStreetMap Nominatim (free, no API key needed). Same data
# source as the Leaflet map tiles already rendered in the merchant
# onboarding flow.

# --- Vercel Blob (free-tier image hosting for merchant logos / hero images) ---
# Provision a Blob store in your Vercel project: Storage -> Create -> Blob.
# Then run `vercel env pull` or paste the token here.
# If unset, /api/uploads/listing-image returns 503 and the dashboard falls
# back to letting merchants paste an external URL.
BLOB_READ_WRITE_TOKEN=

# --- Merchant relay (legacy fallback path) ---
# Classic PAT scoped only to the Purple Club repo, "repo" permission.
GITHUB_BOT_PAT=

# Repo that receives merchant issues + PRs, e.g. "purpleclub/purpleclub".
GITHUB_REPO=

# HMAC secret for signing merchant edit tokens. Generate 32+ random chars.
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SIGNING_SECRET=

# Cloudflare Turnstile captcha on /join.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Origin used by scripts/generate-edit-token.ts when regenerating lost links.
# Defaults to https://purpleclub.org if unset.
PURPLE_CLUB_ORIGIN=
# Feature flags for phased rollout.
USE_DB_LISTINGS=true
USE_GITHUB_RELAY=false

# --- Merchant analytics (privacy-preserving viewer fingerprint) ---
# Random secret used to salt sha256(ip + ua + dayBucket) into an opaque
# viewer hash. Without it we fall back to a per-process random salt
# (fine for dev, breaks uniques across server restarts). Set in prod
# once and never rotate — rotating invalidates historical uniques.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ANALYTICS_HASH_SALT=

# --- Email (Resend, free tier — 100 emails/day) ---
# Sign up at https://resend.com, create an API key.
# Used for merchant approval/rejection notifications.
# If unset, status changes still work — emails are simply skipped.
RESEND_API_KEY=
# Verified sender. While testing without a custom domain, use the value
# `Purple Club <onboarding@resend.dev>` (Resend's sandbox sender).
RESEND_FROM_EMAIL=Purple Club <onboarding@resend.dev>
# Public site origin used in email links. Falls back to https://purpleclub.org.
PUBLIC_SITE_URL=

# ===========================================================================
# Purple Club (ported PurpleStay module) + unified wallet sessions
# ===========================================================================

# HMAC secret for the server-side wallet session cookie (pc_session). Must be
# a long random string (>= 16 chars). Without it, NO wallet session is minted,
# so hotels / gifts / admin APIs all reject. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Wallet role allowlists (comma-separated Solana pubkeys) ---
# Founder wallets are SUPER ADMINS — they implicitly pass every capability
# check (concierge desk, Perks review, promoter, founder consoles).
FOUNDER_WALLETS=
# Concierge / booking-ops operators (the hotel desk). Falls back to
# MAINTAINER_WALLETS if unset.
AGENT_WALLETS=
MAINTAINER_WALLETS=
# Additional, non-founder merchant (Perks) reviewers.
PERKS_ADMIN_WALLETS=

# --- PBTC token + Solana RPC (server-side) ---
# PBTC SPL mint (server reads balances against this).
PBTC_MINT=HfMbPyDdZH6QMaDDUokjYCkHxzjoGBMpgaUvpLWGbF5p
# Server RPC. Either set SOLANA_RPC_URL directly, or HELIUS_API_KEY to build
# the Helius mainnet URL. Falls back to public mainnet-beta.
SOLANA_RPC_URL=
HELIUS_API_KEY=
# Optional: circulating-supply maths for the burn ledger.
PBTC_INITIAL_SUPPLY=

# --- Hotel payments (USDC on Solana) ---
# Treasury wallet that receives member USDC payments for bookings.
PURPLE_STAY_WALLET=
# USDC SPL mint (defaults to mainnet USDC if unset).
USDC_MINT=
# Helius webhook shared secret — set the same value in the Helius dashboard
# webhook config that posts to https://purpleclub.org/api/webhooks/helius
HELIUS_WEBHOOK_AUTH=

# --- Gift / campaign PBTC treasury (auto-fulfillment) ---
# JSON array or base58 secret key of the wallet that sends PBTC gift rewards.
GIFT_TREASURY_SECRET_KEY=

# --- Vercel Blob for voucher PDFs (separate private store recommended) ---
BLOB_PRIVATE_READ_WRITE_TOKEN=

# --- Concierge notifications (Resend) ---
# Name/reply-to/agent inbox for booking + gift notification emails.
RESEND_FROM_NAME=
RESEND_REPLY_TO=
AGENT_NOTIFICATIONS_EMAIL=
# Absolute origin used inside transactional hotel emails. Falls back to
# https://purplestay.co — set to https://purpleclub.org in production.
APP_URL=https://purpleclub.org
BRAND_POSTAL_ADDRESS=

# --- Optional: GitHub mirroring of travel requests (concierge ops) ---
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=

# --- Client feature flag: enable card (Stripe) payment option in hotels ---
NEXT_PUBLIC_CARD_PAYMENTS_ENABLED=false
